# Copie estes nomes para Vercel > Settings > Environment Variables.
# Os valores ficam em Supabase > Project Settings > API.

NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=cole-aqui-a-chave-anon-public

# Chave secreta (service_role). NUNCA coloque no navegador nem no GitHub.
SUPABASE_SERVICE_ROLE_KEY=cole-aqui-a-chave-service_role

# Senha que o coletor do Chrome usa para enviar os dados.
# Invente uma frase longa (ex.: 40 letras e números aleatórios).
INGEST_TOKEN=invente-um-codigo-longo-aqui
